# === Libbord Production Environment ===
# Copy to .env.production and fill in the values

# Server
SERVER_IP=92.63.66.134

# Database (auto-set in docker-compose, but needed for migration script)
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# JWT — must match the secret used when admin accounts were created
JWT_SECRET=CHANGE_ME_same_secret_as_supabase

# Admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=CHANGE_ME_bcrypt_hash

# Yandex.Metrika OAuth
YANDEX_CLIENT_ID=your_yandex_app_id
YANDEX_CLIENT_SECRET=your_yandex_app_secret
YANDEX_REDIRECT_URI=http://92.63.66.134:8100/admin/yandex-callback

# CORS — allow frontend origin
FRONTEND_URL=http://92.63.66.134:8100
CORS_ORIGINS=["http://92.63.66.134:8100"]
